[Unit]
Description=Cybertron · Infinity Prime (recursive watcher)
Documentation=file:/opt/cybertron/README.md
PartOf=cybertron.target
After=cybertron.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cybertron
ExecStart=/opt/cybertron/.venv/bin/python -m infinity.infinity --interval 30
WorkingDirectory=/opt/cybertron
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/cybertron

[Install]
WantedBy=cybertron.target
