[Unit]
Description=Cybertron · Alpha Trion Prime (logging & audit)
Documentation=file:/opt/cybertron/README.md
PartOf=cybertron.target
After=cybertron.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cybertron
ExecStart=/opt/cybertron/.venv/bin/python -m primes.alphatrion.alphatrion --interval 60
WorkingDirectory=/opt/cybertron
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/cybertron

[Install]
WantedBy=cybertron.target
