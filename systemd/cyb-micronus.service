[Unit]
Description=Cybertron · Micronus Prime (thermal & power)
Documentation=file:/opt/cybertron/README.md
PartOf=cybertron.target
After=cybertron.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cybertron
ExecStart=/opt/cybertron/.venv/bin/python -m primes.micronus.micronus --interval 5
WorkingDirectory=/opt/cybertron
Restart=on-failure
RestartSec=3
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/cybertron

[Install]
WantedBy=cybertron.target
