[Unit]
Description=Cybertron · Maximals (trend database)
Documentation=file:/opt/cybertron/README.md
PartOf=cybertron.target
After=cybertron.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cybertron
ExecStart=/opt/cybertron/.venv/bin/python -m beastwars.maximals --interval 120
WorkingDirectory=/opt/cybertron
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/cybertron /var/lib/cybertron

[Install]
WantedBy=cybertron.target
