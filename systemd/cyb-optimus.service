[Unit]
Description=Cybertron · Optimus (rollup daemon + control socket)
Documentation=file:/opt/cybertron/README.md
PartOf=cybertron.target
After=cybertron.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/cybertron
ExecStart=/opt/cybertron/.venv/bin/python -m optimus.daemon.optimusd
WorkingDirectory=/opt/cybertron
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/cybertron

[Install]
WantedBy=cybertron.target
